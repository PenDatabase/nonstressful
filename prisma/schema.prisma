generator client {
  provider = "prisma-client"
  output   = "../src/generated.prisma"
}

datasource db {
  provider = "postgresql"
}

enum FileType {
  COURSE_REG
  JAMB_RESULT
  BIRTH_CERTIFICATE
  COURSE_DUES
}

enum SubmissionStatus {
  NOT_PAID
  PAID
  REVIEWED
  SUBMITTED
}

model User {
  id  String @id @default(uuid()) @db.Uuid
  regNo String @unique
  name  String?
  password String @unique
  isAdmin Boolean @default(false)
  submissions Submission[]
}

model Submission {
  id  String @id @default(uuid()) @db.Uuid
  submittedBy User @relation(fields: [userId], references: [id])
  userId String @db.Uuid
  files File[]
  status SubmissionStatus @default(NOT_PAID)
  date DateTime @default(now())
}

model File {
  id String @id @default(uuid()) @db.Uuid
  type FileType
  key String
  copies Int @default(1)
  belongsTo Submission @relation(fields: [submissionId], references: [id])
  submissionId String @db.Uuid
  date DateTime @default(now())
}